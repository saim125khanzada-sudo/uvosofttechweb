<!DOCTYPE html>
<html lang="<%= typeof activeRegion !== 'undefined' ? activeRegion.code : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | Uvosoft - Uvosoft Tech Enterprise Solutions' : 'Uvosoft | Uvosoft Tech - Cloud, SaaS, Odoo ERP & Cybersecurity' %></title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : 'Uvosoft (Uvosoft Tech) provides enterprise IT services, Odoo & Microsoft Dynamics 365 ERP consultation, cloud migration, MDM implementation, cybersecurity, and hardware store sales.' %>">
  <meta name="keywords" content="uvosoft, uvosoft tech, uvosofttech, uvosofttech.com, UVO SoftTech, Uvosoft IT Services, Odoo ERP, Dynamics 365, Cloud Migration, Cybersecurity, MDM, Computer Hardware Store, USA, Canada, Saudi Arabia, Pakistan, Physiobridge, ATCC">
  <meta name="author" content="Uvosoft Tech">
  <meta name="application-name" content="Uvosoft Tech">
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  <meta name="google-site-verification" content="YOUR_GOOGLE_SEARCH_CONSOLE_VERIFICATION_CODE_HERE" />

  <!-- Regional SEO Hreflang Tags -->
  <link rel="alternate" hreflang="en-US" href="https://uvosofttech.com/?region=us" />
  <link rel="alternate" hreflang="en-CA" href="https://uvosofttech.com/?region=ca" />
  <link rel="alternate" hreflang="ar-SA" href="https://uvosofttech.com/?region=sa" />
  <link rel="alternate" hreflang="en-PK" href="https://uvosofttech.com/?region=pk" />
  <link rel="alternate" type="application/rss+xml" title="Uvosoft Tech RSS Feed" href="https://uvosofttech.com/rss.xml" />
  <link rel="canonical" href="https://uvosofttech.com<%= typeof currentPath !== 'undefined' ? currentPath : '' %>" />

  <!-- Open Graph / Social Cards for Uvosoft Tech -->
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Uvosoft | Uvosoft Tech Enterprise Solutions' %>">
  <meta property="og:site_name" content="Uvosoft Tech">
  <meta property="og:description" content="Uvosoft Tech - Enterprise IT Services, Odoo & Dynamics 365 ERP, Cloud Infrastructure & Cybersecurity globally.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://uvosofttech.com">
  <meta property="og:image" content="https://uvosofttech.com/images/logo.png">

  <!-- Fonts & Style -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;700;800&family=Outfit:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/css/public.css">

  <!-- Rich JSON-LD Structured Data Schemas for #1 Search Ranking & Rich FAQ Snippets -->
  <script type="application/ld+json">
  [
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Uvosoft Tech",
      "legalName": "UVO SoftTech",
      "alternateName": ["Uvosoft", "Uvosoft Tech", "UvosoftTech", "uvosofttech.com"],
      "url": "https://uvosofttech.com",
      "logo": "https://uvosofttech.com/images/logo.png",
      "description": "Uvosoft Tech provides enterprise Odoo & Dynamics 365 ERP consultation, cloud migration, MDM implementation, computer hardware sales, and cybersecurity.",
      "telephone": "+923718055990",
      "email": "marketing@uvosofttech.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Plot R-103, Sector 4B, Surjani town",
        "addressLocality": "Karachi",
        "addressCountry": "PK"
      },
      "sameAs": [
        "https://www.linkedin.com/company/uvosoft",
        "https://github.com/saim125khanzada-sudo/uvosofttechweb"
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "Uvosoft Tech - Enterprise IT & ERP Solutions",
      "image": "https://uvosofttech.com/images/logo.png",
      "@id": "https://uvosofttech.com",
      "url": "https://uvosofttech.com",
      "telephone": "+923718055990",
      "priceRange": "$$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Plot R-103, Sector 4B, Surjani town",
        "addressLocality": "Karachi",
        "addressCountry": "PK"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 24.974,
        "longitude": 67.037
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
        "opens": "00:00",
        "closes": "23:59"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Uvosoft Tech?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Uvosoft Tech (UVO SoftTech) is an enterprise technology engineering company headquartered in Karachi, Pakistan, specializing in Odoo & Microsoft Dynamics 365 ERP consultation, SaaS cloud migration, MDM implementation, hardware sales, and cybersecurity for global clients in USA, Canada, Saudi Arabia, and Pakistan."
          }
        },
        {
          "@type": "Question",
          "name": "What services does Uvosoft Tech provide?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Uvosoft Tech provides custom software development, Odoo & Dynamics 365 ERP setup, AWS/Azure cloud migration, cybersecurity pentesting, Mobile Device Management (MDM), laptop sales, and startup open-source smart-save solutions."
          }
        },
        {
          "@type": "Question",
          "name": "How can I contact Uvosoft Tech?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can contact Uvosoft Tech via WhatsApp/Phone at +923718055990 or via email at marketing@uvosofttech.com and uvosofttech@gmail.com."
          }
        }
      ]
    }
  ]
  </script>
  <link rel="icon" type="image/png" href="/images/logo.png">
</head>
<body>
  <!-- 3D Graphics Canvases & FX -->
  <div class="cursor-glow" id="cursorGlow"></div>
  <div class="scanline"></div>
  <div class="sweep-line"></div>
  <canvas id="matrix-canvas"></canvas>
  <canvas id="ai-canvas"></canvas>

  <!-- Navigation Bar -->
  <header class="navbar">
    <a href="/" class="nav-logo" style="display:flex; align-items:center; gap:10px; text-decoration:none;">
      <img src="/images/logo.png" alt="Uvosoft Tech Logo" class="nav-logo-img" style="height: 42px; width: auto; object-fit: contain;">
    </a>

    <nav>
      <ul class="nav-links">
        <li><a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>">Home</a></li>
        <li class="nav-item-dropdown">
          <a href="/services" class="nav-link <%= currentPath.startsWith('/services') ? 'active' : '' %>">Services ▾</a>
          <div class="nav-dropdown">
            <a href="/services/development">💻 Custom Software & Web Dev</a>
            <a href="/services/development/ERP-Development">📊 ERP Development (Odoo / Dynamics 365)</a>
            <a href="/services/development/website-development">🌐 Website Development</a>
            <a href="/services/cloud-devops">☁️ Cloud Engineering & DevOps</a>
            <a href="/services/cybersecurity">🛡️ Enterprise Cybersecurity</a>
            <a href="/services/ai-automation">🤖 AI Engineering & Automation</a>
            <a href="/services" style="border-top: 1px solid rgba(255,255,255,0.1); margin-top: 4px; padding-top: 10px; color: var(--primary-pink) !important; font-weight: 700;">
              ⚡ All 24+ Services Directory →
            </a>
          </div>
        </li>
        <li><a href="/store" class="nav-link <%= currentPath === '/store' || currentPath === '/products' ? 'active' : '' %>">Hardware Store</a></li>
        <li><a href="/blog" class="nav-link <%= currentPath === '/blog' ? 'active' : '' %>">Blogs</a></li>
        <li><a href="/about" class="nav-link <%= currentPath === '/about' ? 'active' : '' %>">About Us</a></li>
        <li><a href="/contact" class="nav-link <%= currentPath === '/contact' ? 'active' : '' %>">Contact</a></li>
      </ul>
    </nav>

    <div class="nav-actions" style="display:flex; align-items:center; gap:12px;">
      <a href="#quote" class="btn-primary trigger-quote-modal" style="padding:0.6rem 1.4rem; font-size:0.85rem;">Get Quote</a>

      <% if (user) { %>
        <a href="/admin" class="btn-login">Portal</a>
      <% } else { %>
        <a href="/auth/login" class="btn-login">Client Login</a>
      <% } %>

      <button class="mobile-toggle" id="mobileToggle" aria-label="Toggle navigation">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <!-- Main Body Content -->
  <main class="main-content">
    <%- body %>
  </main>

  <!-- Floating Social & Chatbot Action Buttons -->
  <div class="fab-container">
    <div class="fab fab-chatbot" id="chatbotToggle" title="AI IT Assistant">
      <svg width="24" height="24" fill="white" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12c0 1.54.36 2.99.97 4.29L2 22l5.71-.97C9.01 21.64 10.46 22 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 10.9 13 11.5 13 13h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H8c0-2.21 1.79-4 4-4s4 1.79 4 4c0 .88-.36 1.68-.93 2.25z"/></svg>
    </div>
    <a href="https://www.linkedin.com/company/uvosoft" target="_blank" rel="noopener noreferrer" class="fab fab-linkedin">
      <svg width="24" height="24" fill="white" viewBox="0 0 24 24"><path d="M19 0h-14c-2.76 0-5 2.24-5 5v14c0 2.76 2.24 5 5 5h14c2.76 0 5-2.24 5-5v-14c0-2.76-2.24-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.25c-.97 0-1.75-.78-1.75-1.75s.78-1.75 1.75-1.75 1.75.78 1.75 1.75-.78 1.75-1.75 1.75zm13.5 12.25h-3v-5.6c0-1.36-.5-2.28-1.65-2.28-.9 0-1.42.61-1.65 1.2-.09.21-.1.5-.1.79v5.89h-3v-11h3v1.56c.43-.67 1.15-1.56 3.1-1.56 2.24 0 3.92 1.47 3.92 4.62v6.38z"/></svg>
    </a>
    <a href="https://wa.me/923718055990" target="_blank" rel="noopener noreferrer" class="fab fab-whatsapp">
      <svg width="24" height="24" fill="white" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.149-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    </a>
  </div>

  <!-- Chatbot Window -->
  <div class="chatbot-window" id="chatbotWindow">
    <div class="chat-header">
      <h4>Uvosoft AI Assistant</h4>
      <span>Online | Instant IT & ERP Help</span>
    </div>
    <div class="chat-body" id="chatBody">
      <div class="chat-msg bot-msg">
        Hello! I am the Uvosoft AI. How can I assist you with Cloud, Odoo/Dynamics ERP, Cybersecurity, or Hardware Store inquiries in <strong><%= activeRegion ? activeRegion.name : 'your region' %></strong>?
      </div>
    </div>
    <div class="chat-input-area">
      <input type="text" id="chatInput" placeholder="Type your message..." />
      <button id="chatSendBtn">Send</button>
    </div>
  </div>

  <!-- Quick Consultation Quote Modal -->
  <div class="modal-overlay" id="quoteModal">
    <div class="modal-box">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
        <h3 class="gradient-text" style="font-size:1.5rem;">Request Instant Consultation</h3>
        <button class="close-modal" style="background:none; border:none; color:#FFF; font-size:1.4rem; cursor:pointer;">✕</button>
      </div>
      <p style="color:var(--text-gray); font-size:0.9rem; margin-bottom:24px;">
        Submit your project scope for Cloud, Odoo/Dynamics 365 ERP, Cybersecurity, or Hardware Store inquiries for <strong><%= activeRegion ? activeRegion.name : 'USA' %> Market</strong>.
      </p>

      <form action="/api/v1/contact" method="POST">
        <div class="form-group">
          <label class="form-label">Full Name</label>
          <input type="text" name="name" class="form-control" placeholder="John Doe" required />
        </div>
        <div class="form-group">
          <label class="form-label">Business Email</label>
          <input type="email" name="email" class="form-control" placeholder="john@company.com" required />
        </div>
        <div class="form-group">
          <label class="form-label">Service Category</label>
          <select name="service" class="form-control" style="background:#030305; color:#FFF;">
            <option value="ERP">Odoo / Dynamics 365 ERP Consultation</option>
            <option value="Cloud">SaaS & Cloud Deployment (AWS / Azure)</option>
            <option value="Cybersecurity">Cybersecurity & MDM Implementation</option>
            <option value="Startup">Startup Smart-Save Open Source Solutions</option>
            <option value="Store">Enterprise Hardware Purchase</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Project Details / Requirements</label>
          <textarea name="message" class="form-control" rows="3" placeholder="Describe your team size, timeline, and goals..." required></textarea>
        </div>
        <button type="submit" class="btn-primary" style="width:100%; border:none;">Submit Inquiry</button>
      </form>
    </div>
  </div>

  <!-- Footer -->
  <footer class="footer-container">
    <div class="footer-grid">
      <div>
        <a href="/" style="display:inline-block; margin-bottom:16px; text-decoration:none;">
          <img src="/images/logo.png" alt="UVO SoftTech" style="height: 44px; width: auto; object-fit: contain;">
        </a>
        <p style="color:var(--text-gray); font-size:0.9rem; max-width:320px; line-height:1.6;">
          Global leader in enterprise IT services, SaaS cloud engineering, Odoo/Dynamics 365 ERP, cybersecurity, and open-source cost saving stacks for startups.
        </p>
      </div>

      <div>
        <h4 style="color:#FFF; margin-bottom:16px; font-family:'Space Grotesk',sans-serif;">Services & Solutions</h4>
        <ul style="list-style:none; display:flex; flex-direction:column; gap:8px; font-size:0.9rem;">
          <li><a href="/services/it-backoffice-support" style="color:var(--text-gray); text-decoration:none;">IT Backoffice Support</a></li>
          <li><a href="/services/software-mobile-dev" style="color:var(--text-gray); text-decoration:none;">Software & Mobile Dev</a></li>
          <li><a href="/services/odoo-dynamics-365-erp" style="color:var(--text-gray); text-decoration:none;">Odoo & Dynamics 365 ERP</a></li>
          <li><a href="/services/cloud-devops" style="color:var(--text-gray); text-decoration:none;">Cloud Engineering & DevOps</a></li>
          <li><a href="/services/cybersecurity-pentesting" style="color:var(--text-gray); text-decoration:none;">Cybersecurity & Pentesting</a></li>
          <li><a href="/services/ai-engineering-llms" style="color:var(--text-gray); text-decoration:none;">AI Engineering & LLMs</a></li>
          <li><a href="/store" style="color:var(--text-gray); text-decoration:none;">Hardware Store</a></li>
        </ul>
      </div>

      <div>
        <h4 style="color:#FFF; margin-bottom:16px; font-family:'Space Grotesk',sans-serif;">Featured Clients</h4>
        <ul style="list-style:none; display:flex; flex-direction:column; gap:8px; font-size:0.9rem; color:var(--text-gray);">
          <li>Physiobridge Clinic</li>
          <li>Australian Transport Compliance Centres (ATCC)</li>
          <li>Enterprise Local Partners</li>
        </ul>
      </div>

      <div>
        <h4 style="color:#FFF; margin-bottom:16px; font-family:'Space Grotesk',sans-serif;">Official Contact & HQ</h4>
        <p style="color:var(--text-white); font-size:0.85rem; margin-bottom:6px;">🇵🇰 <strong>Pakistan HQ:</strong></p>
        <p style="color:var(--text-gray); font-size:0.8rem; margin-bottom:8px; line-height:1.4;">Plot R-103, Sector 4B, Surjani town, Karachi</p>
        <a href="https://wa.me/923718055990" target="_blank" style="color:var(--primary-pink); font-size:0.85rem; font-weight:600; text-decoration:none; display:block; margin-bottom:4px;">
          📞 Phone / WhatsApp: +923718055990
        </a>
        <a href="mailto:marketing@uvosofttech.com" style="color:var(--text-gray); font-size:0.8rem; text-decoration:none; display:block; margin-bottom:2px;">
          ✉️ marketing@uvosofttech.com
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <div>© <%= new Date().getFullYear() %> UVO SoftTech. All rights reserved. Registered Operations in Karachi, Pakistan.</div>
      <div>
        <a href="/sitemap.xml" style="color:var(--text-gray); margin-right:12px;">XML Sitemap</a>
        <a href="/robots.txt" style="color:var(--text-gray);">Robots.txt</a>
      </div>
    </div>
  </footer>

  <script src="/js/public.js"></script>
  <script src="/js/client-suite.js"></script>
</body>
</html>
