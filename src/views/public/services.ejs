<!-- Dedicated Services Page with Category Filter Tabs -->
<section class="content-section" style="padding-top: 140px;">
  <h1 class="section-title">Our <span>Technology Services</span></h1>
  <p class="section-subtitle">Comprehensive IT solutions, custom development, cloud engineering, and cybersecurity services.</p>

  <div class="tabs-container">
    <button class="tab-btn active" onclick="filterServices('it')">IT Backoffice Support</button>
    <button class="tab-btn" onclick="filterServices('dev')">Software & Mobile Dev</button>
    <button class="tab-btn" onclick="filterServices('erp')">Odoo & Dynamics 365 ERP</button>
    <button class="tab-btn" onclick="filterServices('cloud')">Cloud & DevOps</button>
    <button class="tab-btn" onclick="filterServices('cyber')">Cybersecurity & Pentesting</button>
    <button class="tab-btn" onclick="filterServices('ai')">AI Engineering & LLMs</button>
  </div>

  <div class="grid-container" id="servicesGrid">
    <!-- Filtered by JavaScript filterServices() -->
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const services = {
    it: [
      { title: "Local & Remote IT Backoffice Support", desc: "Reliable local and remote IT backoffice support to ensure your daily operations run smoothly without interruptions. Troubleshooting, system maintenance, and user support." },
      { title: "Windows / Linux Server Management", desc: "Server setup, virtualization, backup solutions, Active Directory management, file server configuration, and DHCP services for maximum uptime." },
      { title: "Network Support (LAN, WAN, VLANs)", desc: "End-to-end network support, bandwidth management, structured cabling, and advanced configurations for switches, routers, and VLANs." },
      { title: "Firewall Installation & Configuration", desc: "Implementation and management of security firewall solutions to protect your business network from unauthorized access and cyber threats." }
    ],
    dev: [
      { title: "Custom Business Applications (HRM, CRM, ERP)", desc: "Tailored business apps including HRM, HCM, payroll, CRM, asset management, inventory, and gatekeeper security applications." },
      { title: "Mobile Application Development", desc: "High-performance iOS and Android mobile applications built for security, scalability, and seamless user experience." },
      { title: "Responsive Webapp & Portal Development", desc: "Modern, responsive, and fast web applications designed with enterprise security standards and API integrations." }
    ],
    erp: [
      { title: "Odoo ERP Implementation & Customization", desc: "Full lifecycle Odoo Community and Enterprise setup, module customization, POS sync, inventory management, and multi-currency accounting." },
      { title: "Microsoft Dynamics 365 Deployments", desc: "Implementation, customization, and migration for Dynamics 365 Finance & Operations and Business Central." }
    ],
    cloud: [
      { title: "Cloud Migration & Architecture (AWS / Azure)", desc: "End-to-end cloud deployment, serverless microservices, Kubernetes container orchestration, and multi-cloud setup." },
      { title: "Cloud Cost Optimization", desc: "Analyze cloud resource utilization, eliminate waste, and right-size infrastructure to save up to 50% on cloud bills." },
      { title: "MDM & Mobile Application Management", desc: "Mobile Device Management (MDM) enrollment, remote device wipe, access control policies, and corporate security enforcement." }
    ],
    cyber: [
      { title: "Application Security & Penetration Testing", desc: "Identify and remediate security vulnerabilities across SDLC. Web application, mobile, and API penetration testing." },
      { title: "Active Directory & Infrastructure Pentesting", desc: "Simulate real-world attacks against enterprise Active Directory, domain controllers, and internal network infrastructure." },
      { title: "24x7 Security Operations Center (SOC)", desc: "Continuous 24/7 security monitoring, log analysis, SIEM management, threat detection, and incident response." }
    ],
    ai: [
      { title: "AI Engineering & LLM Integration", desc: "Generative AI, Large Language Models (LLMs), Retrieval-Augmented Generation (RAG), and intelligent AI agent workflows." }
    ]
  };

  window.filterServices = function(category) {
    const grid = document.getElementById('servicesGrid');
    if (!grid || !services[category]) return;
    grid.innerHTML = '';
    services[category].forEach(s => {
      grid.innerHTML += `<div class="glass-card"><h3>${s.title}</h3><p>${s.desc}</p></div>`;
    });
    document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
    if (event && event.target) event.target.classList.add('active');
  };

  filterServices('it');
});
</script>
