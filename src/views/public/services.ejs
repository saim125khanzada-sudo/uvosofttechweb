<!-- Dedicated Services Directory Page -->
<section class="content-section" style="padding-top: 140px; padding-bottom: 80px;">
  <div style="text-align: center; max-width: 900px; margin: 0 auto 40px;">
    <h1 class="section-title" style="font-size: clamp(2.2rem, 5vw, 3.4rem);">Our Technology <span>Services Directory</span></h1>
    <p class="section-subtitle" style="font-size: 1.1rem; color: var(--text-gray); line-height: 1.6;">
      Explore dedicated solution pages for enterprise IT backoffice support, custom software development, Odoo/Dynamics 365 ERP, cloud DevOps, cybersecurity, and AI LLM engineering.
    </p>
  </div>

  <div class="grid-container" style="grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 28px; max-width: 1200px; margin: 0 auto;">
    <% 
      const serviceList = typeof services !== 'undefined' && services && services.length > 0 ? services : [
        { slug: 'it-backoffice-support', icon: '🛠️', heroBadge: '24/7 Managed IT Operations', categoryName: 'IT Backoffice Support', title: 'IT Backoffice Support & Infrastructure Operations', subtitle: 'Reliable remote & local IT helpdesk, server management, active directory, network support, and firewalls.' },
        { slug: 'software-mobile-dev', icon: '💻', heroBadge: 'Custom Software Engineering', categoryName: 'Software & Mobile Dev', title: 'Custom Software & Mobile App Development', subtitle: 'Tailored enterprise software, HRM/CRM portals, iOS/Android mobile apps, and cloud APIs.' },
        { slug: 'odoo-dynamics-365-erp', icon: '📊', heroBadge: 'Enterprise ERP Implementation', categoryName: 'Odoo & Dynamics 365 ERP', title: 'Odoo ERP & Microsoft Dynamics 365 Solutions', subtitle: 'Full lifecycle ERP implementation, custom modules, POS sync, inventory, and accounting.' },
        { slug: 'cloud-devops', icon: '☁️', heroBadge: 'Cloud Architecture & DevOps', categoryName: 'Cloud & DevOps', title: 'Cloud Engineering, Migration & DevOps Architecture', subtitle: 'AWS, Azure, and GCP architectures, CI/CD automated deployment pipelines, Kubernetes, and Cloud Cost Optimization.' },
        { slug: 'cybersecurity-pentesting', icon: '🛡️', heroBadge: 'Offensive Security & Pentesting', categoryName: 'Cybersecurity & Pentesting', title: 'Enterprise Cybersecurity & Penetration Testing', subtitle: 'Web app pentesting, Active Directory security audits, SOC 24/7 monitoring, and vulnerability assessments.' },
        { slug: 'ai-engineering-llms', icon: '🤖', heroBadge: 'Enterprise AI Solutions', categoryName: 'AI Engineering & LLMs', title: 'AI Engineering & Custom LLM Integration', subtitle: 'Generative AI, Retrieval-Augmented Generation (RAG) over corporate data, autonomous AI agents, and custom chatbots.' }
      ];
    %>

    <% serviceList.forEach(s => { %>
      <div class="glass-card" style="display: flex; flex-direction: column; justify-content: space-between; padding: 32px; border-color: rgba(255, 0, 117, 0.25); background: rgba(15, 23, 42, 0.75);">
        <div>
          <div style="font-size: 2.5rem; margin-bottom: 16px;"><%= s.icon %></div>
          <div style="color: var(--primary-pink); font-weight: 700; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 8px;"><%= s.heroBadge %></div>
          <h2 style="font-size: 1.45rem; color: #FFF; margin-bottom: 12px; font-family: 'Space Grotesk', sans-serif; line-height: 1.3;"><%= s.title %></h2>
          <p style="color: var(--text-gray); font-size: 0.93rem; line-height: 1.6; margin-bottom: 24px;"><%= s.subtitle %></p>
        </div>

        <div>
          <a href="/services/<%= s.slug %>" class="btn-primary" style="display: block; text-align: center; font-size: 0.95rem; padding: 0.85rem 1rem; text-decoration: none;">
            View Dedicated <%= s.categoryName %> Page →
          </a>
        </div>
      </div>
    <% }); %>
  </div>
</section>
