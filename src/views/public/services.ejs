<!-- Dedicated Services Directory & Category Showcase Page -->
<section class="content-section" style="padding-top: 140px; padding-bottom: 80px;">
  <div style="text-align: center; max-width: 950px; margin: 0 auto 50px;">
    <% if (typeof currentCategory !== 'undefined' && currentCategory) { %>
      <div style="background: rgba(255,0,117,0.12); border: 1px solid rgba(255,0,117,0.35); color: var(--primary-pink); font-size: 0.85rem; font-weight: 700; padding: 6px 16px; border-radius: 20px; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 20px;">
        <span><%= currentCategory.icon %></span> <%= currentCategory.name %>
      </div>
      <h1 class="section-title" style="font-size: clamp(2.2rem, 5vw, 3.4rem);"><%= currentCategory.name %> <span>Services</span></h1>
      <p class="section-subtitle" style="font-size: 1.1rem; color: var(--text-gray); line-height: 1.6;">
        <%= currentCategory.description %>
      </p>
    <% } else { %>
      <h1 class="section-title" style="font-size: clamp(2.2rem, 5vw, 3.4rem);">Technology <span>Services & Solutions</span></h1>
      <p class="section-subtitle" style="font-size: 1.1rem; color: var(--text-gray); line-height: 1.6;">
        Explore our 24+ dedicated enterprise service pages across Custom Software & Web Development, Cloud DevOps, Cybersecurity & Pentesting, and AI Automation.
      </p>
    <% } %>
  </div>

  <!-- Category Filter Pills -->
  <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; max-width: 1100px; margin: 0 auto 50px;">
    <a href="/services" class="tab-btn <%= typeof currentCategory === 'undefined' || !currentCategory ? 'active' : '' %>" style="text-decoration: none;">
      All Categories (24 Pages)
    </a>
    <% (typeof categories !== 'undefined' && categories ? categories : []).forEach(cat => { %>
      <a href="/services/<%= cat.slug %>" class="tab-btn <%= typeof currentCategory !== 'undefined' && currentCategory && currentCategory.slug === cat.slug ? 'active' : '' %>" style="text-decoration: none;">
        <%= cat.icon %> <%= cat.name %>
      </a>
    <% }); %>
  </div>

  <!-- Service Cards Grid -->
  <div class="grid-container" style="grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 28px; max-width: 1200px; margin: 0 auto;">
    <% (typeof services !== 'undefined' && services && services.length > 0 ? services : []).forEach(s => { %>
      <div class="glass-card" style="display: flex; flex-direction: column; justify-content: space-between; padding: 32px; border-color: rgba(255, 0, 117, 0.25); background: rgba(15, 23, 42, 0.85);">
        <div>
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
            <span style="font-size: 2.4rem;"><%= s.icon || '⚡' %></span>
            <span style="background: rgba(0, 240, 255, 0.1); border: 1px solid rgba(0, 240, 255, 0.3); color: var(--neon-blue); font-size: 0.72rem; font-weight: 700; padding: 4px 10px; border-radius: 12px; text-transform: uppercase;">
              <%= s.categoryName %>
            </span>
          </div>

          <h2 style="font-size: 1.35rem; color: #FFF; margin-bottom: 12px; font-family: 'Space Grotesk', sans-serif; line-height: 1.3;">
            <%= s.h1 || s.title %>
          </h2>

          <p style="color: var(--text-gray); font-size: 0.92rem; line-height: 1.6; margin-bottom: 20px;">
            <%= s.heroSubtitle || s.subtitle %>
          </p>

          <% if (s.keywords) { %>
            <div style="font-size: 0.78rem; color: #64748b; margin-bottom: 20px; line-height: 1.4;">
              <strong style="color: #94a3b8;">Keywords:</strong> <%= s.keywords.split(',').slice(0, 3).join(', ') %>
            </div>
          <% } %>
        </div>

        <div>
          <a href="<%= s.urlPath || ('/services/' + s.categorySlug + '/' + s.slug) %>" class="btn-primary" style="display: block; text-align: center; font-size: 0.92rem; padding: 0.85rem 1rem; text-decoration: none;">
            View <%= s.h1 || s.title %> Page →
          </a>
        </div>
      </div>
    <% }); %>
  </div>
</section>
