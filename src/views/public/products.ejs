<!-- Dedicated Hardware Store Page -->
<section class="content-section" style="padding-top: 140px;">
  <h1 class="section-title">Hardware <span>Store</span></h1>
  <p class="section-subtitle">Enterprise laptops, RAM (DDR3/DDR4/DDR5), SSD/NVMe storage, desktop LCD monitors, and computer accessories in Pakistan (PKR Rs.).</p>

  <div style="background: linear-gradient(90deg, rgba(255,0,117,0.15), rgba(255,107,0,0.15)); border: 1px solid rgba(255,0,117,0.4); border-radius: 12px; padding: 14px 20px; text-align: center; margin-bottom: 24px; display: flex; align-items: center; justify-content: center; gap: 10px;">
    <span style="font-size: 1.4rem;">🚚</span>
    <span style="color: #FFF; font-weight: 700; font-size: 0.95rem;">FREE EXPRESS DELIVERY ACROSS ALL PAKISTAN CITIES (Karachi, Lahore, Islamabad, Rawalpindi, Peshawar, Quetta & Nationwide)</span>
  </div>

  <div class="store-filters" style="display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; margin-bottom: 30px;">
    <button class="filter-btn active" onclick="filterProducts('all')">All Products</button>
    <button class="filter-btn" onclick="filterProducts('Laptops')">Laptops & MacBooks</button>
    <button class="filter-btn" onclick="filterProducts('RAM')">RAM (DDR3 / DDR4 / DDR5)</button>
    <button class="filter-btn" onclick="filterProducts('Storage')">Storage (HDD / SSD / NVMe)</button>
    <button class="filter-btn" onclick="filterProducts('Monitors')">LCD Monitors</button>
    <button class="filter-btn" onclick="filterProducts('Accessories')">Peripherals & Headsets</button>
  </div>

  <div class="grid-container" id="storeGrid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">
    <!-- Filtered by JavaScript filterProducts() -->
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const currencySymbol = "Rs. ";

  const products = <%- JSON.stringify(products && products.length > 0 ? products : [
    { id: "1", brand: "Lenovo", model: "ThinkPad T14 Gen 2 (Core i7 11th Gen)", category: "Laptops", price: 135000, ram: "16GB DDR4", ssd: "512GB NVMe", gpu: "Intel Iris Xe", imageUrl: "/images/products/laptop-thinkpad.jpg" },
    { id: "2", brand: "Corsair", model: "Vengeance LPX 16GB DDR4 3200MHz RAM", category: "RAM", price: 9500, ram: "16GB", ssd: "N/A", gpu: "N/A", imageUrl: "/images/products/ram-ddr4.jpg" },
    { id: "3", brand: "Crucial", model: "32GB DDR5 5600MHz Desktop Memory", category: "RAM", price: 28500, ram: "32GB DDR5", ssd: "N/A", gpu: "N/A", imageUrl: "/images/products/ram-ddr5.jpg" },
    { id: "4", brand: "Samsung", model: "980 PRO 1TB M.2 PCIe Gen4 NVMe SSD", category: "Storage", price: 24500, ram: "N/A", ssd: "1TB NVMe", gpu: "N/A", imageUrl: "/images/products/storage-nvme.jpg" },
    { id: "5", brand: "Dell", model: "24\" IPS Full HD Monitor (P2419H)", category: "Monitors", price: 26500, ram: "N/A", ssd: "N/A", gpu: "N/A", imageUrl: "/images/products/monitor-dell-24.jpg" },
    { id: "6", brand: "HyperX", model: "Cloud II Gaming Headset (7.1 Surround)", category: "Accessories", price: 14800, ram: "N/A", ssd: "N/A", gpu: "N/A", imageUrl: "/images/products/headset-hyperx.jpg" }
  ]) %>;

  window.filterProducts = function(cat) {
    const grid = document.getElementById('storeGrid');
    if (!grid) return;
    grid.innerHTML = '';

    const filtered = cat === 'all' ? products : products.filter(p => {
      const pCat = p.category || p.categorySlug || p.brand || '';
      return pCat.toLowerCase().includes(cat.toLowerCase());
    });

    if (filtered.length === 0) {
      grid.innerHTML = '<p style="text-align:center; color:var(--text-gray); grid-column: 1/-1;">No hardware items available in this category right now.</p>';
      return;
    }

    filtered.forEach(p => {
      const pPrice = typeof p.price === 'number' ? p.price : parseFloat(p.price) || 0;
      const priceStr = pPrice > 0 ? pPrice.toLocaleString('en-PK') : (p.price || 'Contact for Price');
      const formattedPrice = typeof pPrice === 'number' && pPrice > 0 ? currencySymbol + priceStr : priceStr;
      const imgUrl = p.imageUrl || p.img || '/images/logo.png';
      const msg = `Hello UVO SoftTech, I am interested in purchasing ${p.brand || ''} ${p.model || p.name} (${formattedPrice}) with Free Delivery Across Pakistan. Is it available?`;
      const waLink = `https://wa.me/923718055990?text=${encodeURIComponent(msg)}`;

      grid.innerHTML += `
        <div class="glass-card" style="padding: 0; overflow: hidden; display:flex; flex-direction:column; background: rgba(15,22,42,0.85); border: 1px solid rgba(0,240,255,0.25); border-radius: 12px;">
          <div style="height: 180px; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; overflow: hidden;">
            <img src="${imgUrl}" alt="${p.model || p.name}" style="max-height: 100%; max-width: 100%; object-fit: contain;" onerror="this.src='/images/logo.png'">
          </div>
          <div style="padding: 1.2rem; flex-grow:1; display:flex; flex-direction:column; justify-content:space-between;">
            <div>
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                <span style="color:var(--neon-blue); font-weight:700; font-size:0.85rem;">${p.brand || p.category || 'Hardware'}</span>
                <span style="color:var(--neon-pink); font-weight:700; font-size:1.15rem;">${formattedPrice}</span>
              </div>
              <h3 style="font-size:1.1rem; margin-bottom:8px; color:#FFF; line-height: 1.3;">${p.model || p.name}</h3>
              <div style="background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.35); color: #10b981; font-size: 0.75rem; font-weight: 700; padding: 4px 10px; border-radius: 20px; margin-bottom: 12px; display: inline-flex; align-items: center; gap: 4px;">
                <span>🚚</span> Free Delivery in Pakistan
              </div>
              ${p.ram || p.ssd ? `
              <div style="background:rgba(255,255,255,0.03); padding:8px 10px; border-radius:6px; border:1px solid rgba(255,255,255,0.08); font-size:0.8rem; color:var(--text-gray); margin-bottom:14px;">
                ${p.ram && p.ram !== 'N/A' ? `<div>⚡ RAM: <strong style="color:#FFF;">${p.ram}</strong></div>` : ''}
                ${p.ssd && p.ssd !== 'N/A' ? `<div>💾 Storage: <strong style="color:#FFF;">${p.ssd}</strong></div>` : ''}
                ${p.gpu && p.gpu !== 'N/A' ? `<div>🎮 GPU: <strong style="color:#FFF;">${p.gpu}</strong></div>` : ''}
              </div>
              ` : ''}
            </div>
            <a href="${waLink}" target="_blank" class="btn-primary" style="text-align:center; font-size:0.85rem; padding:0.7rem 1rem; text-decoration: none;">
              Buy Now / Inquire via WhatsApp →
            </a>
          </div>
        </div>
      `;
    });

    document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
    if (event && event.target) event.target.classList.add('active');
  };

  filterProducts('all');
});
</script>
