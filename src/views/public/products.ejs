<!-- Dedicated Hardware Store Page -->
<section class="content-section" style="padding-top: 140px;">
  <h1 class="section-title">Hardware <span>Store</span></h1>
  <p class="section-subtitle">Enterprise laptops, mobile workstations, and computing hardware configured for corporate teams.</p>

  <div class="store-filters">
    <button class="filter-btn active" onclick="filterProducts('all')">All Brands</button>
    <button class="filter-btn" onclick="filterProducts('HP')">HP</button>
    <button class="filter-btn" onclick="filterProducts('Dell')">Dell</button>
    <button class="filter-btn" onclick="filterProducts('Lenovo')">Lenovo</button>
    <button class="filter-btn" onclick="filterProducts('Apple')">Apple</button>
  </div>

  <div class="grid-container" id="storeGrid">
    <!-- Filtered by JavaScript filterProducts() -->
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const currencySymbol = "<%= typeof activeRegion !== 'undefined' ? activeRegion.symbol : '$' %>";

  const products = [
    { id: 1, brand: "HP", model: "EliteBook 840 G10", price: 1200, ram: "16GB DDR5", ssd: "512GB NVMe", gpu: "Intel Iris Xe", img: "https://images.unsplash.com/photo-1496181133206-80ce9b88a853?q=80&w=800&auto=format&fit=crop" },
    { id: 2, brand: "Dell", model: "Latitude 5540 Pro Workstation", price: 1350, ram: "32GB DDR5", ssd: "1TB NVMe M.2", gpu: "Intel Iris Xe", img: "https://images.unsplash.com/photo-1593642632823-8f785ba67e45?q=80&w=800&auto=format&fit=crop" },
    { id: 3, brand: "Lenovo", model: "ThinkPad X1 Carbon Gen 11", price: 1500, ram: "32GB LPDDR5", ssd: "1TB NVMe SSD", gpu: "Integrated Graphics", img: "https://images.unsplash.com/photo-1611186871348-b1ce696e52c9?q=80&w=800&auto=format&fit=crop" },
    { id: 4, brand: "Apple", model: "MacBook Pro 16\" M3 Pro", price: 2100, ram: "36GB Unified", ssd: "512GB Fast SSD", gpu: "18-Core GPU", img: "https://images.unsplash.com/photo-1517336714731-489689fd1ca8?q=80&w=800&auto=format&fit=crop" },
    { id: 5, brand: "Dell", model: "XPS 15 9530 Workstation", price: 1950, ram: "32GB DDR5", ssd: "1TB SSD", gpu: "NVIDIA RTX 4050 6GB", img: "https://images.unsplash.com/photo-1588872657578-7efd1f1555ed?q=80&w=800&auto=format&fit=crop" },
    { id: 6, brand: "HP", model: "ZBook Studio G10 Mobile Studio", price: 2400, ram: "64GB DDR5", ssd: "2TB NVMe SSD", gpu: "NVIDIA RTX 4070 8GB", img: "https://images.unsplash.com/photo-1525547719571-a2d4ac8945e2?q=80&w=800&auto=format&fit=crop" }
  ];

  window.filterProducts = function(brand) {
    const grid = document.getElementById('storeGrid');
    if (!grid) return;
    grid.innerHTML = '';

    const filtered = brand === 'all' ? products : products.filter(p => p.brand === brand);

    if (filtered.length === 0) {
      grid.innerHTML = '<p style="text-align:center; color:var(--text-gray); grid-column: 1/-1;">No products available in this brand category right now.</p>';
      return;
    }

    filtered.forEach(p => {
      const formattedPrice = currencySymbol + p.price;
      const msg = `Hello UVO SoftTech, I am interested in purchasing the ${p.brand} ${p.model} (${formattedPrice}). Is it in stock?`;
      const waLink = `https://wa.me/923718055990?text=${encodeURIComponent(msg)}`;

      grid.innerHTML += `
        <div class="glass-card" style="padding: 0; overflow: hidden; display:flex; flex-direction:column;">
          <img src="${p.img}" alt="${p.model}" class="product-img">
          <div style="padding: 1.5rem; flex-grow:1; display:flex; flex-direction:column; justify-content:space-between;">
            <div>
              <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                <span style="color:var(--neon-blue); font-weight:700; font-size:0.85rem;">${p.brand}</span>
                <span style="color:var(--neon-pink); font-weight:700; font-size:1.2rem;">${formattedPrice}</span>
              </div>
              <h3 style="font-size:1.2rem; margin-bottom:12px; color:#FFF;">${p.model}</h3>
              <div style="background:rgba(255,255,255,0.03); padding:10px; border-radius:6px; border:1px solid rgba(255,255,255,0.08); font-size:0.85rem; color:var(--text-gray); margin-bottom:16px;">
                <div>⚡ RAM: <strong style="color:#FFF;">${p.ram}</strong></div>
                <div>💾 SSD: <strong style="color:#FFF;">${p.ssd}</strong></div>
                <div>🎮 GPU: <strong style="color:#FFF;">${p.gpu}</strong></div>
              </div>
            </div>
            <a href="${waLink}" target="_blank" class="btn-primary" style="text-align:center; font-size:0.9rem; padding:0.8rem 1rem;">
              Inquire via WhatsApp →
            </a>
          </div>
        </div>
      `;
    });

    document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
    if (event && event.target) event.target.classList.add('active');
  };

  filterProducts('all');
});
</script>
