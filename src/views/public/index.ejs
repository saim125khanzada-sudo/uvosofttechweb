      <h3 style="font-size:1.25rem; margin-bottom:8px;">Canada</h3>
      <p style="color:var(--text-muted); font-size:0.9rem; margin-bottom:12px;">Toronto, Ontario</p>
      <small style="color:var(--primary-cyan);">+1 (800) 555-UVO2</small>
    </div>

    <div class="glass-panel card-3d">
      <div style="font-size:2.5rem; margin-bottom:12px;">🇸🇦</div>
      <h3 style="font-size:1.25rem; margin-bottom:8px;">Saudi Arabia</h3>
      <p style="color:var(--text-muted); font-size:0.9rem; margin-bottom:12px;">Riyadh, KSA</p>
      <small style="color:var(--primary-cyan);">+966 11 555 UVO3</small>
    </div>

    <div class="glass-panel card-3d">
      <div style="font-size:2.5rem; margin-bottom:12px;">🇵🇰</div>
      <h3 style="font-size:1.25rem; margin-bottom:8px;">Pakistan</h3>
      <p style="color:var(--text-muted); font-size:0.9rem; margin-bottom:12px;">Islamabad Tech Center</p>
