    <!-- Contact Form -->
    <div class="glass-card">
      <h3 style="font-size: 1.5rem; margin-bottom: 12px;" class="gradient-text">Send Direct Inquiry</h3>
      <p style="color: var(--text-gray); font-size: 0.9rem; margin-bottom: 24px;">
