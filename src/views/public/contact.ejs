            <option value="ca">🇨🇦 Canada Market</option>
            <option value="sa">🇸🇦 Saudi Arabia (KSA) Market</option>
            <option value="pk">🇵🇰 Pakistan HQ</option>
          </select>
        </div>

        <div class="form-group" style="margin-top:14px;">
          <label class="form-label" style="display:block; margin-bottom:6px; font-size:0.9rem;">Detailed Message / Scope *</label>
          <textarea name="message" class="form-control" rows="5" style="width:100%; padding:10px; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.15); border-radius:6px; color:#fff;" placeholder="Describe your ERP, Cloud, Security, or Hardware store needs..." required></textarea>
        </div>

        <button type="submit" class="btn-primary" style="width:100%; margin-top:20px; border:none;">Submit Message</button>
      </form>
    </div>

