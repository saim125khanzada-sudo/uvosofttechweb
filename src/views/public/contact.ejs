        <div class="form-group" style="margin-top:14px;">
          <label class="form-label" style="display:block; margin-bottom:6px; font-size:0.9rem;">Target Region / Market</label>
          <select name="region" class="form-control" style="width:100%; padding:10px; background:#030305; border:1px solid rgba(255,255,255,0.15); border-radius:6px; color:#fff;">
