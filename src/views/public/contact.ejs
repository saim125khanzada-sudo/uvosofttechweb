      <form action="/api/v1/contact" method="POST" id="contactForm">
        <div class="form-group">
          <label class="form-label" style="display:block; margin-bottom:6px; font-size:0.9rem;">Your Full Name *</label>
          <input type="text" name="name" class="form-control" style="width:100%; padding:10px; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.15); border-radius:6px; color:#fff;" placeholder="John Doe" required />
