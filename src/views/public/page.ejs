<section class="page-header">
  <div class="container">
    <h1><%= title %></h1>
  </div>
</section>

<section class="page-content">
  <div class="container">
    <% if (typeof page !== 'undefined' && page) { %>
      <% if (page.sections && page.sections.length > 0) { %>
        <% page.sections.forEach(function(section) { %>
          <div class="page-section" id="section-<%= section.slug %>">
            <% if (section.title) { %>
              <h2><%= section.title %></h2>
            <% } %>
            <div class="section-content">
              <% if (typeof section.content === 'object') { %>
                <% if (section.content.html) { %>
                  <%- section.content.html %>
                <% } else if (section.content.text) { %>
                  <p><%= section.content.text %></p>
                <% } %>
              <% } else { %>
                <%- section.content %>
              <% } %>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="about-intro">
          <h2>About Uvosoft Tech</h2>
          <p>Uvosoft Tech is a leading technology solutions provider dedicated to delivering innovative software development, IT consulting, and digital transformation services. With years of experience in the industry, we have helped hundreds of businesses achieve their technology goals.</p>
          <h3>Our Mission</h3>
          <p>To empower businesses through cutting-edge technology solutions that drive growth, efficiency, and innovation.</p>
          <h3>Our Vision</h3>
          <p>To be the global leader in technology solutions, recognized for our commitment to excellence and customer satisfaction.</p>
          <h3>Why Choose Us?</h3>
          <ul>
            <li>Experienced team of developers and engineers</li>
            <li>Custom solutions tailored to your needs</li>
            <li>24/7 support and maintenance</li>
            <li>Competitive pricing and transparent communication</li>
            <li>Proven track record of successful projects</li>
          </ul>
        </div>
      <% } %>
    <% } else { %>
      <div class="about-intro">
        <h2>About Uvosoft Tech</h2>
        <p>Uvosoft Tech is a leading technology solutions provider dedicated to delivering innovative software development, IT consulting, and digital transformation services.</p>
        <h3>Our Mission</h3>
        <p>To empower businesses through cutting-edge technology solutions that drive growth, efficiency, and innovation.</p>
        <h3>Our Vision</h3>
        <p>To be the global leader in technology solutions, recognized for our commitment to excellence and customer satisfaction.</p>
      </div>
    <% } %>
  </div>
</section>
