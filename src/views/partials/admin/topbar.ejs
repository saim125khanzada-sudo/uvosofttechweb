<header class="admin-topbar">
  <div class="topbar-left">
    <button class="sidebar-toggle" id="sidebarToggle">☰</button>
    <h1 class="page-title"><%= typeof title !== 'undefined' ? title : 'Admin' %></h1>
  </div>
  <div class="topbar-right">
    <a href="/" target="_blank" class="btn btn-sm btn-outline" style="color:#fff; text-decoration:none; margin-right:12px;">View Site</a>
    <div class="user-menu" style="display:inline-block;">
      <span class="user-name" style="color:var(--text-color, #fff); font-weight:600;"><%= (typeof user !== 'undefined' && user && user.firstName) ? (user.firstName + ' ' + (user.lastName || '')) : 'Super Admin' %></span>
      <a href="/auth/logout" class="btn btn-sm btn-danger" style="margin-left:12px; color:#ff4d4d; text-decoration:none;">Logout</a>
    </div>
  </div>
</header>
