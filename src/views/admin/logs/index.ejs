
<div class="content-header">
  <h2>Activity Logs</h2>
</div>

<div class="table-responsive">
  <table class="data-table">
    <thead>
      <tr>
        <th>Date</th>
        <th>Action</th>
        <th>Entity</th>
        <th>User</th>
        <th>IP Address</th>
        <th>Details</th>
      </tr>
    </thead>
    <tbody>
      <% if (typeof logs !== 'undefined' && logs.length > 0) { %>
        <% logs.forEach(function(log) { %>
          <tr>
            <td><%= new Date(log.createdAt).toLocaleString() %></td>
            <td><span class="badge badge-<%= log.action === 'create' ? 'success' : log.action === 'delete' ? 'danger' : log.action === 'login' ? 'info' : 'secondary' %>"><%= log.action %></span></td>
            <td><%= log.entityType %></td>
            <td><%= log.user ? log.user.firstName + ' ' + log.user.lastName : 'System' %></td>
            <td><%= log.ipAddress || '-' %></td>
            <td class="text-truncate" style="max-width:200px;">
              <% if (log.details) { %>
                <%= JSON.stringify(log.details) %>
              <% } else { %>
                -
              <% } %>
            </td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr><td colspan="6">No activity logs found.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

