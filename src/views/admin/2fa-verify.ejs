<!-- 2FA TOTP Verification Screen -->
<section style="min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 40px 24px;">
  <div class="glass-panel card-3d" style="width: 100%; max-width: 440px; text-align: center;">
    
    <div style="font-size: 3rem; margin-bottom: 16px;">🔐</div>

    <h2 class="gradient-text" style="font-size: 1.8rem; margin-bottom: 8px;">Two-Factor Authentication</h2>
    <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 28px;">
      Enter the 6-digit TOTP code from your authenticator app (Google Authenticator, Authy, or Microsoft Authenticator).
    </p>

    <% if (typeof flash !== 'undefined' && flash && flash.error) { %>
      <div style="background: rgba(255, 0, 85, 0.15); border: 1px solid var(--accent-coral); color: #FF6B8B; padding: 12px 16px; border-radius: var(--radius-md); font-size: 0.85rem; margin-bottom: 20px;">
        <%= flash.error.join(', ') %>
      </div>
    <% } %>

    <form action="/auth/2fa/verify" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div class="form-group" style="text-align: left;">
        <label class="form-label">6-Digit Security Code</label>
        <input 
          type="text" 
          name="token" 
          class="form-control" 
          placeholder="e.g. 123456" 
          maxlength="6" 
          autocomplete="off" 
          style="font-size: 1.4rem; letter-spacing: 6px; text-align: center; font-family: monospace;" 
          required 
          autofocus 
        />
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 10px;">
        Verify & Continue
      </button>
    </form>

    <div style="margin-top: 24px; border-top: 1px solid var(--border-glass); padding-top: 16px;">
      <a href="/auth/logout" style="color: var(--text-muted); font-size: 0.85rem;">← Cancel & Return to Login</a>
    </div>

  </div>
</section>
