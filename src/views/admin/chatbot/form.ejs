
<div class="content-header">
  <h2><%= title %></h2>
  <a href="/admin/chatbot" class="btn btn-outline">Back to Chatbot</a>
</div>

<div class="form-card">
  <form id="chatbotForm" data-entity="chatbot" data-id="<%= response ? response.id : '' %>" class="admin-form">
    <div class="form-group">
      <label for="triggerKeywords">Trigger Keywords (comma-separated) *</label>
      <input type="text" id="triggerKeywords" name="triggerKeywordsRaw" required
        placeholder="e.g., price, cost, how much"
        value="<%= response ? response.triggerKeywords.join(', ') : '' %>">
      <small>Separate multiple keywords with commas</small>
    </div>
    <div class="form-group">
      <label for="responseText">Response Text *</label>
      <textarea id="responseText" name="responseText" rows="6" required maxlength="2000"><%= response ? response.responseText : '' %></textarea>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="priority">Priority (higher = matched first)</label>
        <input type="number" id="priority" name="priority" min="0" value="<%= response ? response.priority : 0 %>">
      </div>
      <div class="form-group">
        <label class="checkbox-label">
          <input type="checkbox" name="isActive" value="true" <%= response ? (response.isActive ? 'checked' : '') : 'checked' %>>
          Active
        </label>
      </div>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save</button>
      <a href="/admin/chatbot" class="btn btn-outline">Cancel</a>
    </div>
  </form>
</div>

