
<div class="content-header">
  <h2><%= title %></h2>
  <a href="/admin/roles" class="btn btn-outline">Back to Roles</a>
</div>

<div class="form-card">
  <form id="roleForm" data-entity="roles" data-id="<%= role ? role.id : '' %>" class="admin-form">
    <div class="form-group">
      <label for="name">Role Name *</label>
      <input type="text" id="name" name="name" required maxlength="50" pattern="[a-zA-Z0-9_-]+" value="<%= role ? role.name : '' %>">
    </div>
    <div class="form-group">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="3" maxlength="255"><%= role ? (role.description || '') : '' %></textarea>
    </div>
    <div class="form-group">
      <label>Permissions</label>
      <div class="checkbox-group permissions-grid">
        <% if (typeof permissions !== 'undefined' && permissions.length > 0) { %>
          <% let currentCategory = ''; %>
          <% permissions.forEach(function(perm) { %>
            <% if (perm.category !== currentCategory) { %>
              <% currentCategory = perm.category; %>
              <div class="permission-category">
                <strong><%= currentCategory %></strong>
              </div>
            <% } %>
            <label class="checkbox-label">
              <input type="checkbox" name="permissionIds" value="<%= perm.id %>"
                <%= role && role.permissionIds && role.permissionIds.includes(perm.id) ? 'checked' : '' %>>
              <%= perm.name %>
              <% if (perm.description) { %>
                <small class="perm-desc"> - <%= perm.description %></small>
              <% } %>
            </label>
          <% }); %>
        <% } %>
      </div>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save</button>
      <a href="/admin/roles" class="btn btn-outline">Cancel</a>
    </div>
  </form>
</div>

