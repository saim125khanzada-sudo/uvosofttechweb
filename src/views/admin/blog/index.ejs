
<div class="content-header">
  <h2>Blog Posts</h2>
  <a href="/admin/blog/create" class="btn btn-primary">Add Post</a>
</div>

<div class="table-responsive">
  <table class="data-table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Author</th>
        <th>Status</th>
        <th>Published</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (typeof posts !== 'undefined' && posts.length > 0) { %>
        <% posts.forEach(function(post) { %>
          <tr>
            <td><%= post.title %></td>
            <td><%= post.author.firstName %> <%= post.author.lastName %></td>
            <td><span class="badge badge-<%= post.status === 'published' ? 'success' : post.status === 'archived' ? 'warning' : 'info' %>"><%= post.status %></span></td>
            <td><%= post.publishedAt ? new Date(post.publishedAt).toLocaleDateString() : '-' %></td>
            <td>
              <a href="/admin/blog/<%= post.id %>/edit" class="btn btn-sm btn-outline">Edit</a>
              <button class="btn btn-sm btn-danger btn-delete" data-entity="blog" data-id="<%= post.id %>">Delete</button>
            </td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr><td colspan="5">No blog posts found.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

