<div class="content-header">
  <h2><%= title %></h2>
  <a href="/admin/blog" class="btn btn-outline">Back to Blog</a>
</div>

<div class="form-card">
  <form id="blogForm" data-entity="blog" data-id="<%= post ? post.id : '' %>" class="admin-form">
    <div class="form-group">
      <label for="title">Title *</label>
      <input type="text" id="title" name="title" required maxlength="200" value="<%= post ? post.title : '' %>" placeholder="e.g. Odoo ERP 17 Migration Guide & Best Practices">
    </div>
    <div class="form-group">
      <label for="slug">Slug (auto-generated if empty)</label>
      <input type="text" id="slug" name="slug" maxlength="200" pattern="[a-z0-9-]+" value="<%= post ? post.slug : '' %>" placeholder="odoo-erp-17-migration-guide">
    </div>
    <div class="form-group">
      <label for="excerpt">Excerpt / Brief Summary</label>
      <textarea id="excerpt" name="excerpt" rows="3" maxlength="500" placeholder="Short introduction for blog card..."><%= post ? (post.excerpt || '') : '' %></textarea>
    </div>
    <div class="form-group">
      <label for="content">Content (Markdown / HTML) *</label>
      <textarea id="content" name="content" rows="12" required placeholder="Write detailed blog post text here..."><%= post ? post.content : '' %></textarea>
    </div>
    <div class="form-group">
      <label for="featuredImageUrl">Featured Image URL / Header Picture</label>
      <input type="url" id="featuredImageUrl" name="featuredImageUrl" value="<%= post ? (post.featuredImageUrl || '') : '' %>" placeholder="https://images.unsplash.com/... or /uploads/picture.jpg">
    </div>

    <!-- External Dynamic Document & PDF Links -->
    <fieldset class="form-fieldset" style="border:1px solid rgba(0,240,255,0.3); padding:16px; border-radius:8px; margin-bottom:20px;">
      <legend style="color:var(--neon-blue); font-weight:700;">📄 Dynamic External Docs & PDF Attachments</legend>
      <div class="form-group">
        <label for="docUrl">Google Doc Link / External Article URL</label>
        <input type="url" id="docUrl" name="docUrl" value="<%= post ? (post.docUrl || '') : '' %>" placeholder="https://docs.google.com/document/d/... or article link">
        <small style="color:var(--text-gray); display:block; margin-top:4px;">Visitors can view or read the full article directly via your Google Doc link.</small>
      </div>
      <div class="form-group" style="margin-top:12px;">
        <label for="pdfUrl">PDF Whitepaper / Document Download Link</label>
        <input type="url" id="pdfUrl" name="pdfUrl" value="<%= post ? (post.pdfUrl || '') : '' %>" placeholder="https://.../report.pdf or /uploads/whitepaper.pdf">
        <small style="color:var(--text-gray); display:block; margin-top:4px;">Attach downloadable PDF documentation or technical research papers.</small>
      </div>
    </fieldset>

    <div class="form-row">
      <div class="form-group">
        <label for="status">Status</label>
        <select id="status" name="status">
          <option value="draft" <%= post && post.status === 'draft' ? 'selected' : '' %>>Draft</option>
          <option value="published" <%= post && post.status === 'published' ? 'selected' : '' %>>Published</option>
          <option value="archived" <%= post && post.status === 'archived' ? 'selected' : '' %>>Archived</option>
        </select>
      </div>
    </div>
    <fieldset class="form-fieldset">
      <legend>SEO Metadata</legend>
      <div class="form-group">
        <label for="metaTitle">Meta Title</label>
        <input type="text" id="metaTitle" name="metaTitle" maxlength="70" value="<%= post ? (post.metaTitle || '') : '' %>">
      </div>
      <div class="form-group">
        <label for="metaDescription">Meta Description</label>
        <textarea id="metaDescription" name="metaDescription" rows="2" maxlength="160"><%= post ? (post.metaDescription || '') : '' %></textarea>
      </div>
    </fieldset>
    <div class="form-actions" style="margin-top:20px;">
      <button type="submit" class="btn btn-primary">Save Blog Post</button>
      <a href="/admin/blog" class="btn btn-outline">Cancel</a>
    </div>
  </form>
</div>
