
<div class="content-header">
  <h2>Pages</h2>
  <a href="/admin/pages/create" class="btn btn-primary">Add Page</a>
</div>

<div class="table-responsive">
  <table class="data-table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Slug</th>
        <th>Sections</th>
        <th>Published</th>
        <th>Order</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (typeof pages !== 'undefined' && pages.length > 0) { %>
        <% pages.forEach(function(page) { %>
          <tr>
            <td><%= page.title %></td>
            <td><%= page.slug %></td>
            <td><%= page._count.sections %></td>
            <td><span class="badge badge-<%= page.isPublished ? 'success' : 'warning' %>"><%= page.isPublished ? 'Yes' : 'No' %></span></td>
            <td><%= page.sortOrder %></td>
            <td>
              <a href="/admin/pages/<%= page.id %>/edit" class="btn btn-sm btn-outline">Edit</a>
            </td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr><td colspan="6">No pages found.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

