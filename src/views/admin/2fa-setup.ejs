<!-- 2FA TOTP Setup Screen -->
<section style="padding: 40px 24px; max-width: 720px; margin: 0 auto;">
  <div class="glass-panel card-3d">
    
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px; border-bottom:1px solid var(--border-glass); padding-bottom:16px;">
      <div>
        <h2 class="gradient-text" style="font-size: 1.8rem; margin:0;">Setup 2-Factor Authentication</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem; margin-top:4px;">Enhance your Admin/Manager account cybersecurity posture</p>
      </div>
      <span class="btn-neon" style="padding:4px 12px; font-size:0.8rem; border-radius:var(--radius-full);">
        <%= isTwoFactorEnabled ? 'STATUS: ENABLED' : 'STATUS: DISABLED' %>
      </span>
    </div>

    <% if (typeof flash !== 'undefined' && flash && flash.error) { %>
      <div style="background: rgba(255, 0, 85, 0.15); border: 1px solid var(--accent-coral); color: #FF6B8B; padding: 12px 16px; border-radius: var(--radius-md); font-size: 0.85rem; margin-bottom: 20px;">
        <%= flash.error.join(', ') %>
      </div>
    <% } %>

    <% if (typeof flash !== 'undefined' && flash && flash.success) { %>
      <div style="background: rgba(0, 245, 160, 0.15); border: 1px solid var(--accent-neon); color: var(--accent-neon); padding: 12px 16px; border-radius: var(--radius-md); font-size: 0.85rem; margin-bottom: 20px;">
        <%= flash.success.join(', ') %>
      </div>
    <% } %>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: center; margin-bottom: 32px;">
      <div style="text-align: center; background: rgba(255,255,255,0.03); padding: 20px; border-radius: var(--radius-md); border: 1px solid var(--border-glass);">
        <h4 style="font-size: 0.95rem; margin-bottom: 12px; color: var(--text-muted);">Step 1: Scan QR Code</h4>
        <img src="<%= qrCodeUrl %>" alt="2FA QR Code" style="width: 180px; height: 180px; border-radius: 12px; border: 2px solid var(--primary-cyan);" />
        <p style="font-size: 0.75rem; color: var(--text-dim); margin-top: 8px;">Use Google Authenticator, Authy, or Microsoft Authenticator</p>
      </div>

      <div>
        <h4 style="font-size: 1rem; margin-bottom: 8px;">Manual Secret Key</h4>
        <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 12px;">If you cannot scan the QR code, manually enter this base32 secret in your app:</p>

        <div style="background: #070913; padding: 12px 16px; border-radius: var(--radius-md); font-family: monospace; font-size: 1.1rem; color: var(--primary-cyan); letter-spacing: 2px; border: 1px solid var(--border-glow); word-break: break-all; margin-bottom: 20px;">
          <%= secret %>
        </div>

        <h4 style="font-size: 1rem; margin-bottom: 8px;">Step 2: Enter 6-Digit Code</h4>
        <form action="/auth/2fa/enable" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="form-group">
            <input type="text" name="token" class="form-control" placeholder="123456" maxlength="6" style="letter-spacing:4px; font-family:monospace; font-size:1.1rem;" required />
          </div>
          <button type="submit" class="btn btn-primary" style="width: 100%;">Verify & Enable 2FA</button>
        </form>
      </div>
    </div>

    <% if (isTwoFactorEnabled) { %>
      <div style="border-top: 1px solid var(--border-glass); padding-top: 20px; display: flex; justify-content: space-between; align-items: center;">
        <span style="color: var(--text-muted); font-size: 0.85rem;">Disable 2FA protection for this account?</span>
        <form action="/auth/2fa/disable" method="POST" style="display: inline-flex; gap: 8px;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="text" name="token" class="form-control" placeholder="Code" maxlength="6" style="width: 100px; padding: 8px;" required />
          <button type="submit" class="btn btn-glass" style="color: var(--accent-coral); border-color: var(--accent-coral);">Disable 2FA</button>
        </form>
      </div>
    <% } %>

    <div style="margin-top: 24px; text-align: center;">
      <a href="/admin" style="color: var(--text-muted); font-size: 0.85rem;">← Return to Admin Dashboard</a>
    </div>

  </div>
</section>
