
<div class="content-header">
  <h2>Site Settings</h2>
</div>

<div class="settings-container">
  <% if (typeof settings !== 'undefined' && Object.keys(settings).length > 0) { %>
    <% Object.keys(settings).forEach(function(group) { %>
      <div class="settings-group">
        <h3><%= group %></h3>
        <div class="settings-items">
          <% settings[group].forEach(function(setting) { %>
            <div class="setting-item" data-key="<%= setting.key %>">
              <label><%= setting.label %></label>
              <% if (setting.type === 'textarea') { %>
                <textarea class="setting-input" rows="3" data-key="<%= setting.key %>"><%= typeof setting.value === 'string' ? setting.value : JSON.stringify(setting.value) %></textarea>
              <% } else if (setting.type === 'boolean') { %>
                <input type="checkbox" class="setting-input" data-key="<%= setting.key %>" <%= setting.value ? 'checked' : '' %>>
              <% } else if (setting.type === 'number') { %>
                <input type="number" class="setting-input" data-key="<%= setting.key %>" value="<%= setting.value %>">
              <% } else if (setting.type === 'image') { %>
                <input type="url" class="setting-input" data-key="<%= setting.key %>" value="<%= typeof setting.value === 'string' ? setting.value : '' %>" placeholder="Image URL">
              <% } else if (setting.type === 'color') { %>
                <input type="color" class="setting-input" data-key="<%= setting.key %>" value="<%= typeof setting.value === 'string' ? setting.value : '#000000' %>">
              <% } else if (setting.type === 'json') { %>
                <textarea class="setting-input" rows="3" data-key="<%= setting.key %>"><%= typeof setting.value === 'object' ? JSON.stringify(setting.value, null, 2) : setting.value %></textarea>
              <% } else { %>
                <input type="text" class="setting-input" data-key="<%= setting.key %>" value="<%= typeof setting.value === 'string' ? setting.value : JSON.stringify(setting.value) %>">
              <% } %>
              <small>Type: <%= setting.type %> | Key: <%= setting.key %></small>
            </div>
          <% }); %>
        </div>
      </div>
    <% }); %>
  <% } else { %>
    <p>No settings configured yet.</p>
  <% } %>
</div>

<div class="form-actions" style="margin-top:20px;">
  <button type="button" class="btn btn-primary" id="saveAllSettings">Save All Settings</button>
</div>

