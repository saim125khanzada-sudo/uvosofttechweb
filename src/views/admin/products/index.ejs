<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hardware Store Manager - UVO SoftTech Admin</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Space+Grotesk:wght@500;700;800&display=swap" rel="stylesheet">
  <style>
    :root { --bg-dark: #020307; --border-color: rgba(255, 0, 117, 0.25); --primary-pink: #FF0075; --primary-orange: #FF6B00; --text-white: #ffffff; --text-gray: #94a3b8; }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg-dark); color: #fff; font-family: 'Space Grotesk', sans-serif; min-height: 100vh; display: flex; }
    .admin-wrapper { display: flex; width: 100%; min-height: 100vh; }
    .admin-sidebar { width: 260px; background: rgba(8,10,20,0.96); border-right: 1px solid var(--border-color); padding: 24px 16px; display: flex; flex-direction: column; }
    .sidebar-logo { display: flex; align-items: center; gap: 12px; text-decoration: none; padding-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .sidebar-logo img { height: 38px; }
    .sidebar-logo span { font-weight: 800; font-size: 18px; background: linear-gradient(135deg, var(--primary-pink), var(--primary-orange)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .sidebar-nav ul { list-style: none; padding: 0; margin-top: 20px; }
    .sidebar-nav li { margin-bottom: 6px; }
    .sidebar-nav a { display: flex; align-items: center; gap: 12px; padding: 12px 14px; color: var(--text-gray); text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 14px; }
    .sidebar-nav li.active a, .sidebar-nav a:hover { background: linear-gradient(90deg, rgba(255,0,117,0.18), rgba(255,107,0,0.18)); color: #fff; border-left: 3px solid var(--primary-pink); }
    .admin-main { flex: 1; display: flex; flex-direction: column; background: #020307; }
    .admin-topbar { height: 70px; border-bottom: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between; padding: 0 32px; background: rgba(10,12,24,0.85); }
    .admin-content { padding: 32px; flex: 1; }
    .content-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
    .content-header h2 { font-size: 22px; margin: 0; font-weight: 700; }
    .btn-action { padding: 10px 20px; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 14px; display: inline-block; cursor: pointer; border: none; }
    .btn-pink { background: linear-gradient(135deg, #FF0075, #FF6B00); color: #fff; }
    .btn-sm { padding: 6px 12px; font-size: 12px; }
    .btn-outline { background: transparent; border: 1px solid var(--border-color); color: #fff; }
    .btn-danger { background: rgba(239,68,68,0.2); border: 1px solid #ef4444; color: #ef4444; }
    .data-table { width: 100%; border-collapse: collapse; background: rgba(15,23,42,0.7); border: 1px solid var(--border-color); border-radius: 12px; overflow: hidden; }
    .data-table th, .data-table td { padding: 16px; text-align: left; border-bottom: 1px solid rgba(255,255,255,0.06); }
    .data-table th { color: var(--text-gray); font-size: 12px; text-transform: uppercase; background: rgba(8,10,20,0.5); }
    .badge { padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 600; }
    .badge-success { background: rgba(16,185,129,0.2); color: #10b981; }
    .badge-danger { background: rgba(239,68,68,0.2); color: #ef4444; }
    .product-img { width: 44px; height: 44px; border-radius: 6px; object-fit: cover; border: 1px solid var(--border-color); }
  </style>
</head>
<body>
  <div class="admin-wrapper">
    <aside class="admin-sidebar">
      <a href="/admin" class="sidebar-logo">
        <img src="/images/logo.png" alt="UVO SoftTech">
        <span>UVO SoftTech</span>
      </a>
      <nav class="sidebar-nav">
        <ul>
          <li><a href="/admin"><span>📊</span> Dashboard</a></li>
          <li class="active"><a href="/admin/products"><span>💻</span> Hardware Store</a></li>
          <li><a href="/admin/blog"><span>📝</span> Blogs & Docs</a></li>
          <li><a href="/admin/services"><span>💼</span> Services</a></li>
          <li><a href="/admin/contacts"><span>✉️</span> Client Inbox</a></li>
          <li><a href="/" target="_blank"><span>🌐</span> Public Website</a></li>
          <li style="margin-top: 24px;"><a href="/auth/logout" style="color: #ff4d4d;"><span>🚪</span> Sign Out</a></li>
        </ul>
      </nav>
    </aside>

    <main class="admin-main">
      <header class="admin-topbar">
        <h1 style="font-size: 20px; margin: 0; font-weight: 700; background: linear-gradient(135deg, #FF0075, #FF6B00); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Hardware Store Manager</h1>
        <div style="display: flex; align-items: center; gap: 16px;">
          <span style="color: var(--text-gray); font-size: 14px;">Logged in as: <strong style="color: #fff;">Saimuvo Admin</strong></span>
          <a href="/auth/logout" class="btn-action btn-pink btn-sm">Logout</a>
        </div>
      </header>

      <div class="admin-content">
        <div class="content-header">
          <div>
            <h2>Hardware Laptops & Devices</h2>
            <p style="color: var(--text-gray); margin: 4px 0 0 0; font-size: 14px;">Manage items displayed on the public hardware store (<a href="/store" target="_blank" style="color: var(--primary-pink);">/store</a>)</p>
          </div>
          <a href="/admin/products/create" class="btn-action btn-pink">+ Add New Product</a>
        </div>

        <table class="data-table">
          <thead>
            <tr>
              <th>Image</th>
              <th>Brand & Model</th>
              <th>Price</th>
              <th>Hardware Specifications</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (typeof products !== 'undefined' && products && products.length > 0) { %>
              <% products.forEach(function(product) { %>
                <tr>
                  <td><img src="<%= product.imageUrl || 'https://images.unsplash.com/photo-1496181133206-80ce9b88a853?q=80&w=800&auto=format&fit=crop' %>" class="product-img" alt="Laptop"></td>
                  <td><strong style="color:#fff;"><%= product.brand %></strong> <%= product.model %></td>
                  <td style="color: var(--primary-pink); font-weight: 700;">$<%= product.price %></td>
                  <td style="color: var(--text-gray); font-size: 13px;">
                    <% if (product.ram) { %>RAM: <%= product.ram %><% } %>
                    <% if (product.ssd) { %> | SSD: <%= product.ssd %><% } %>
                    <% if (product.gpu) { %> | GPU: <%= product.gpu %><% } %>
                  </td>
                  <td><span class="badge badge-<%= product.isActive !== false ? 'success' : 'danger' %>"><%= product.isActive !== false ? 'Active' : 'Inactive' %></span></td>
                  <td>
                    <a href="/admin/products/<%= product.id %>/edit" class="btn-action btn-outline btn-sm">Edit</a>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td><img src="https://images.unsplash.com/photo-1496181133206-80ce9b88a853?q=80&w=800&auto=format&fit=crop" class="product-img" alt="HP"></td>
                <td><strong style="color:#fff;">HP</strong> EliteBook 840 G8</td>
                <td style="color: var(--primary-pink); font-weight: 700;">$1,200</td>
                <td style="color: var(--text-gray); font-size: 13px;">RAM: 16GB | SSD: 512GB | GPU: Intel Iris Xe</td>
                <td><span class="badge badge-success">Active</span></td>
                <td><a href="/admin/products/create" class="btn-action btn-outline btn-sm">Edit</a></td>
              </tr>
              <tr>
                <td><img src="https://images.unsplash.com/photo-1593642632823-8f785ba67e45?q=80&w=800&auto=format&fit=crop" class="product-img" alt="Dell"></td>
                <td><strong style="color:#fff;">Dell</strong> XPS 15 9510</td>
                <td style="color: var(--primary-pink); font-weight: 700;">$1,900</td>
                <td style="color: var(--text-gray); font-size: 13px;">RAM: 32GB | SSD: 1TB | GPU: NVIDIA RTX 3050 Ti</td>
                <td><span class="badge badge-success">Active</span></td>
                <td><a href="/admin/products/create" class="btn-action btn-outline btn-sm">Edit</a></td>
              </tr>
              <tr>
                <td><img src="https://images.unsplash.com/photo-1611186871348-b1ce696e52c9?q=80&w=800&auto=format&fit=crop" class="product-img" alt="Lenovo"></td>
                <td><strong style="color:#fff;">Lenovo</strong> ThinkPad X1 Carbon Gen 9</td>
                <td style="color: var(--primary-pink); font-weight: 700;">$1,500</td>
                <td style="color: var(--text-gray); font-size: 13px;">RAM: 16GB | SSD: 512GB | GPU: Intel Iris Xe</td>
                <td><span class="badge badge-success">Active</span></td>
                <td><a href="/admin/products/create" class="btn-action btn-outline btn-sm">Edit</a></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
</body>
</html>
