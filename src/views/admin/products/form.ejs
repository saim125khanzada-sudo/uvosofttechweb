
<div class="content-header">
  <h2><%= title %></h2>
  <a href="/admin/products" class="btn btn-outline">Back to Products</a>
</div>

<div class="form-card">
  <form id="productForm" data-entity="products" data-id="<%= product ? product.id : '' %>" class="admin-form">
    <div class="form-row">
      <div class="form-group">
        <label for="brand">Brand *</label>
        <input type="text" id="brand" name="brand" required maxlength="100" value="<%= product ? product.brand : '' %>">
      </div>
      <div class="form-group">
        <label for="model">Model *</label>
        <input type="text" id="model" name="model" required maxlength="100" value="<%= product ? product.model : '' %>">
      </div>
    </div>
    <div class="form-group">
      <label for="price">Price *</label>
      <input type="number" id="price" name="price" required min="0" step="0.01" value="<%= product ? product.price : '' %>">
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="ram">RAM</label>
        <input type="text" id="ram" name="ram" value="<%= product ? (product.ram || '') : '' %>">
      </div>
      <div class="form-group">
        <label for="ssd">SSD</label>
        <input type="text" id="ssd" name="ssd" value="<%= product ? (product.ssd || '') : '' %>">
      </div>
      <div class="form-group">
        <label for="hdd">HDD</label>
        <input type="text" id="hdd" name="hdd" value="<%= product ? (product.hdd || '') : '' %>">
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="gpu">GPU</label>
        <input type="text" id="gpu" name="gpu" value="<%= product ? (product.gpu || '') : '' %>">
      </div>
      <div class="form-group">
        <label for="imageUrl">Image URL</label>
        <input type="url" id="imageUrl" name="imageUrl" value="<%= product ? (product.imageUrl || '') : '' %>">
      </div>
    </div>
    <div class="form-group">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="4"><%= product ? (product.description || '') : '' %></textarea>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="sortOrder">Sort Order</label>
        <input type="number" id="sortOrder" name="sortOrder" min="0" value="<%= product ? product.sortOrder : 0 %>">
      </div>
      <div class="form-group">
        <label class="checkbox-label">
          <input type="checkbox" name="isActive" value="true" <%= product ? (product.isActive ? 'checked' : '') : 'checked' %>>
          Active
        </label>
      </div>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save</button>
      <a href="/admin/products" class="btn btn-outline">Cancel</a>
    </div>
  </form>
</div>

