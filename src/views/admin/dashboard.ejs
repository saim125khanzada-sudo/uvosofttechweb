<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - UVO SoftTech</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-dark: #020307;
      --card-bg: rgba(15, 23, 42, 0.85);
      --border-color: rgba(255, 0, 117, 0.25);
      --primary-pink: #FF0075;
      --primary-orange: #FF6B00;
      --text-white: #ffffff;
      --text-gray: #94a3b8;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 0;
      background-color: var(--bg-dark);
      color: var(--text-white);
      font-family: 'Space Grotesk', 'Inter', sans-serif;
      min-height: 100vh;
      display: flex;
    }
    .admin-wrapper {
      display: flex;
      width: 100%;
      min-height: 100vh;
    }
    .admin-sidebar {
      width: 260px;
      background: rgba(8, 10, 20, 0.96);
      border-right: 1px solid var(--border-color);
      padding: 24px 16px;
      display: flex;
      flex-direction: column;
    }
    .sidebar-logo {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      padding: 0 8px 20px 8px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .sidebar-logo img {
      height: 38px;
      width: auto;
      object-fit: contain;
    }
    .sidebar-logo span {
      font-weight: 800;
      font-size: 18px;
      background: linear-gradient(135deg, var(--primary-pink), var(--primary-orange));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .sidebar-nav ul {
      list-style: none;
      padding: 0;
      margin: 20px 0 0 0;
    }
    .sidebar-nav li { margin-bottom: 6px; }
    .sidebar-nav a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      color: var(--text-gray);
      text-decoration: none;
      border-radius: 8px;
      font-weight: 600;
      font-size: 14px;
      transition: all 0.2s ease;
    }
    .sidebar-nav li.active a, .sidebar-nav a:hover {
      background: linear-gradient(90deg, rgba(255,0,117,0.18), rgba(255,107,0,0.18));
      color: var(--text-white);
      border-left: 3px solid var(--primary-pink);
    }
    .admin-main {
      flex: 1;
      display: flex;
      flex-direction: column;
      background: #020307;
    }
    .admin-topbar {
      height: 70px;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 32px;
      background: rgba(10, 12, 24, 0.85);
      backdrop-filter: blur(10px);
    }
    .admin-content {
      padding: 32px;
      flex: 1;
    }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-bottom: 32px;
    }
    .stat-card {
      background: rgba(15, 23, 42, 0.7);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 24px;
      position: relative;
    }
    .stat-number {
      font-size: 36px;
      font-weight: 800;
      background: linear-gradient(135deg, var(--primary-pink), var(--primary-orange));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .stat-label {
      color: var(--text-gray);
      font-size: 14px;
      margin-top: 4px;
    }
    .stat-link {
      display: inline-block;
      margin-top: 12px;
      color: var(--primary-pink);
      text-decoration: none;
      font-size: 13px;
      font-weight: 600;
    }
    .dashboard-section {
      background: rgba(15, 23, 42, 0.7);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 24px;
    }
    .data-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 16px;
    }
    .data-table th, .data-table td {
      padding: 12px 16px;
      text-align: left;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .data-table th {
      color: var(--text-gray);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .badge {
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 11px;
      font-weight: 600;
    }
    .badge-success { background: rgba(16, 185, 129, 0.2); color: #10b981; }
    .badge-info { background: rgba(59, 130, 246, 0.2); color: #3b82f6; }
    .btn-action {
      padding: 8px 16px;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 600;
      font-size: 13px;
      display: inline-block;
    }
    .btn-pink { background: linear-gradient(135deg, #FF0075, #FF6B00); color: #fff; border: none; }
  </style>
</head>
<body>
  <div class="admin-wrapper">
    <aside class="admin-sidebar">
      <a href="/admin" class="sidebar-logo">
        <img src="/images/logo.png" alt="UVO SoftTech">
        <span>UVO SoftTech</span>
      </a>
      <nav class="sidebar-nav">
        <ul>
          <li class="active"><a href="/admin"><span>📊</span> Dashboard</a></li>
          <li><a href="/admin/products"><span>💻</span> Hardware Store</a></li>
          <li><a href="/admin/blog"><span>📝</span> Blogs & Docs</a></li>
          <li><a href="/admin/services"><span>💼</span> Services</a></li>
          <li><a href="/admin/contacts"><span>✉️</span> Client Inbox</a></li>
          <li><a href="/" target="_blank"><span>🌐</span> Public Website</a></li>
          <li style="margin-top: 24px;"><a href="/auth/logout" style="color: #ff4d4d;"><span>🚪</span> Sign Out</a></li>
        </ul>
      </nav>
    </aside>

    <main class="admin-main">
      <header class="admin-topbar">
        <h1 style="font-size: 20px; margin: 0; font-weight: 700; background: linear-gradient(135deg, #FF0075, #FF6B00); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Admin Control Portal</h1>
        <div style="display: flex; align-items: center; gap: 16px;">
          <span style="color: var(--text-gray); font-size: 14px;">Logged in as: <strong style="color: #fff;"><%= (typeof user !== 'undefined' && user && user.firstName) ? (user.firstName + ' ' + (user.lastName || '')) : 'uvosofttech@gmail.com' %></strong></span>
          <a href="/auth/logout" class="btn-action btn-pink">Logout</a>
        </div>
      </header>

      <div class="admin-content">
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-number"><%= (stats && stats.products) ? stats.products : 6 %></div>
            <div class="stat-label">Hardware Laptops</div>
            <a href="/admin/products" class="stat-link">Manage Products →</a>
          </div>
          <div class="stat-card">
            <div class="stat-number"><%= (stats && stats.blogPosts) ? stats.blogPosts : 3 %></div>
            <div class="stat-label">Published Articles</div>
            <a href="/admin/blog" class="stat-link">Manage Blogs →</a>
          </div>
          <div class="stat-card">
            <div class="stat-number"><%= (stats && stats.services) ? stats.services : 32 %></div>
            <div class="stat-label">Services Offered</div>
            <a href="/admin/services" class="stat-link">View Services →</a>
          </div>
          <div class="stat-card">
            <div class="stat-number"><%= (stats && stats.contacts) ? stats.contacts : 0 %></div>
            <div class="stat-label">Client Inquiries</div>
            <a href="/admin/contacts" class="stat-link">View Messages →</a>
          </div>
        </div>

        <div class="dashboard-section">
          <h2 style="font-size: 18px; margin-top: 0; margin-bottom: 16px;">System Activity & System Audit</h2>
          <% if (typeof recentLogs !== 'undefined' && recentLogs && recentLogs.length > 0) { %>
            <table class="data-table">
              <thead>
                <tr>
                  <th>Action</th>
                  <th>Entity</th>
                  <th>User</th>
                  <th>Date</th>
                </tr>
              </thead>
              <tbody>
                <% recentLogs.forEach(function(log) { %>
                  <tr>
                    <td><span class="badge badge-<%= log.action === 'create' ? 'success' : 'info' %>"><%= log.action %></span></td>
                    <td><%= log.entityType %></td>
                    <td><%= log.user ? log.user.firstName + ' ' + log.user.lastName : 'Super Admin' %></td>
                    <td><%= new Date(log.createdAt).toLocaleString() %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          <% } else { %>
            <p style="color: var(--text-gray); margin: 0;">System operational. Authenticated session active for <strong>uvosofttech@gmail.com</strong>.</p>
          <% } %>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
