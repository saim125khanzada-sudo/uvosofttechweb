
<div class="content-header">
  <h2>Services</h2>
  <a href="/admin/services/create" class="btn btn-primary">Add Service</a>
</div>

<div class="table-responsive">
  <table class="data-table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Category</th>
        <th>Order</th>
        <th>Active</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (typeof services !== 'undefined' && services.length > 0) { %>
        <% services.forEach(function(service) { %>
          <tr>
            <td><%= service.title %></td>
            <td><%= service.category ? service.category.name : '-' %></td>
            <td><%= service.sortOrder %></td>
            <td><span class="badge badge-<%= service.isActive ? 'success' : 'danger' %>"><%= service.isActive ? 'Yes' : 'No' %></span></td>
            <td>
              <a href="/admin/services/<%= service.id %>/edit" class="btn btn-sm btn-outline">Edit</a>
            </td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr><td colspan="5">No services found.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

